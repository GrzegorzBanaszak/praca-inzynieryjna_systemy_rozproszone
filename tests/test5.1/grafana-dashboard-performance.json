{
  "title": "System Rozproszony - Test Wydajności",
  "tags": ["microservices", "performance", "test"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h"]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "🎯 Test Status",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "id": 101,
      "type": "stat",
      "title": "Overall Test Status",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "(\n  (histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"apigateway\"}[1m])) by (le)) * 1000 < 500)\n  AND\n  ((sum(rate(http_requests_received_total{job=\"apigateway\",code=~\"5..\"}[1m])) / sum(rate(http_requests_received_total{job=\"apigateway\"}[1m]))) < 0.05 OR absent(sum(rate(http_requests_received_total{job=\"apigateway\",code=~\"5..\"}[1m]))))\n  AND\n  (sum(rate(http_requests_received_total{job=\"apigateway\"}[1m])) > 50)\n) OR on() vector(0)",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "✅ ALL PASSED",
                  "color": "green"
                },
                "0": {
                  "text": "❌ FAILED",
                  "color": "red"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "⚠️ NO DATA",
                  "color": "orange"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 0, "color": "red" },
              { "value": 1, "color": "green" }
            ]
          }
        }
      },
      "options": {
        "textMode": "name",
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "id": 102,
      "type": "stat",
      "title": "✅ THRESHOLDS CHECK",
      "gridPos": {
        "h": 6,
        "w": 16,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"apigateway\"}[1m])) by (le)) * 1000 < 500",
          "refId": "P95",
          "legendFormat": "P95 < 500ms"
        },
        {
          "expr": "(sum(rate(http_requests_received_total{job=\"apigateway\",code=~\"5..\"}[1m])) / sum(rate(http_requests_received_total{job=\"apigateway\"}[1m]))) * 100 < 5 OR on() vector(1)",
          "refId": "ErrorRate",
          "legendFormat": "Error Rate < 5%"
        },
        {
          "expr": "sum(rate(http_requests_received_total{job=\"apigateway\"}[1m])) > 50",
          "refId": "Throughput",
          "legendFormat": "Throughput > 50 req/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "✅ PASS",
                  "color": "green"
                },
                "0": {
                  "text": "❌ FAIL",
                  "color": "red"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "⚠️ N/A",
                  "color": "orange"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 0, "color": "red" },
              { "value": 1, "color": "green" }
            ]
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "id": 1,
      "type": "row",
      "title": "🖥️ Services Status",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Status Serwisów",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "up{job=~\"apigateway|productservice|userservice|orderservice\"}",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "color": "green"
                },
                "0": {
                  "text": "DOWN",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 0, "color": "red" },
              { "value": 1, "color": "green" }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "📊 Services Health & Metrics",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "up{job=~\"apigateway|productservice|userservice|orderservice\"}",
          "refId": "Status",
          "format": "table",
          "instant": true
        },
        {
          "expr": "rate(http_requests_received_total{job=~\"apigateway|productservice|userservice|orderservice\"}[1m]) OR on(job) up{job=~\"apigateway|productservice|userservice|orderservice\"} * 0",
          "refId": "Throughput",
          "format": "table",
          "instant": true
        },
        {
          "expr": "rate(process_cpu_seconds_total{job=~\"apigateway|productservice|userservice|orderservice\"}[1m]) * 100 OR on(job) up{job=~\"apigateway|productservice|userservice|orderservice\"} * 0",
          "refId": "CPU",
          "format": "table",
          "instant": true
        },
        {
          "expr": "process_working_set_bytes{job=~\"apigateway|productservice|userservice|orderservice\"} / 1024 / 1024 OR on(job) up{job=~\"apigateway|productservice|userservice|orderservice\"} * 0",
          "refId": "Memory",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "instance": true,
              "__name__": true
            },
            "indexByName": {},
            "renameByName": {
              "job": "Service",
              "Value #Status": "Status",
              "Value #Throughput": "Throughput (req/s)",
              "Value #CPU": "CPU %",
              "Value #Memory": "Memory (MB)"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "center",
            "displayMode": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": { "text": "✅ UP", "color": "green" },
                      "0": { "text": "❌ DOWN", "color": "red" }
                    }
                  }
                ]
              },
              { "id": "custom.displayMode", "value": "color-background" }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Throughput (req/s)"
            },
            "properties": [
              { "id": "custom.displayMode", "value": "gradient-gauge" },
              { "id": "unit", "value": "reqps" },
              { "id": "max", "value": 100 },
              { "id": "decimals", "value": 2 }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CPU %"
            },
            "properties": [
              { "id": "custom.displayMode", "value": "gradient-gauge" },
              { "id": "unit", "value": "percent" },
              { "id": "max", "value": 100 },
              { "id": "decimals", "value": 2 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "value": null, "color": "green" },
                    { "value": 50, "color": "yellow" },
                    { "value": 80, "color": "red" }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Memory (MB)"
            },
            "properties": [
              { "id": "custom.displayMode", "value": "gradient-gauge" },
              { "id": "unit", "value": "decmbytes" },
              { "id": "max", "value": 512 },
              { "id": "decimals", "value": 0 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "value": null, "color": "green" },
                    { "value": 256, "color": "yellow" },
                    { "value": 400, "color": "red" }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": { "show": false }
      }
    },
    {
      "id": 4,
      "type": "row",
      "title": "📊 Performance Metrics",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "collapsed": false
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Przepustowość (Requests/Second)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_received_total{job=\"apigateway\"}[1m]))",
          "legendFormat": "Total",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_requests_received_total{job=\"apigateway\",code=~\"2..\"}[1m]))",
          "legendFormat": "2xx Success",
          "refId": "B"
        },
        {
          "expr": "sum(rate(http_requests_received_total{job=\"apigateway\",code=~\"5..\"}[1m]))",
          "legendFormat": "5xx Errors",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "5xx Errors" },
            "properties": [
              {
                "id": "color",
                "value": { "mode": "fixed", "fixedColor": "red" }
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": ["mean", "max", "last"]
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Czas Odpowiedzi (P50, P95, P99)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{job=\"apigateway\"}[1m])) by (le)) * 1000",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"apigateway\"}[1m])) by (le)) * 1000",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job=\"apigateway\"}[1m])) by (le)) * 1000",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "p95" },
            "properties": [
              {
                "id": "color",
                "value": { "mode": "fixed", "fixedColor": "orange" }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "p99" },
            "properties": [
              {
                "id": "color",
                "value": { "mode": "fixed", "fixedColor": "red" }
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": ["mean", "max", "last"]
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "CPU Usage (%)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 29
      },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{job=~\"apigateway|productservice|userservice|orderservice\"}[1m]) * 100",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": ["mean", "max", "last"]
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Memory Usage (MB)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 29
      },
      "targets": [
        {
          "expr": "process_working_set_bytes{job=~\"apigateway|productservice|userservice|orderservice\"} / 1024 / 1024",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": ["mean", "max", "last"]
        }
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "📈 Summary Statistics",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 37
      },
      "collapsed": false
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Total Requests (5m)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 38
      },
      "targets": [
        {
          "expr": "sum(increase(http_requests_received_total{job=\"apigateway\"}[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "blue" },
              { "value": 1000, "color": "green" },
              { "value": 10000, "color": "yellow" }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "area"
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Avg Response Time (p50)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 38
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{job=\"apigateway\"}[1m])) by (le)) * 1000",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 50, "color": "yellow" },
              { "value": 200, "color": "red" }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "area"
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "P95 Response Time",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 38
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"apigateway\"}[1m])) by (le)) * 1000",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 200, "color": "yellow" },
              { "value": 500, "color": "red" }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "area"
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Success Rate",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 38
      },
      "targets": [
        {
          "expr": "(sum(rate(http_requests_received_total{job=\"apigateway\",code=~\"2..\"}[1m])) / sum(rate(http_requests_received_total{job=\"apigateway\"}[1m]))) * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 95, "color": "yellow" },
              { "value": 99, "color": "green" }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "area"
      }
    }
  ],
  "annotations": {
    "list": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "expr": "changes(up{job=\"apigateway\"}[1m]) > 0",
        "iconColor": "red",
        "name": "Service Restart",
        "tagKeys": "job"
      }
    ]
  }
}
